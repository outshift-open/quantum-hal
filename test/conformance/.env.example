# HAL API Test Configuration
# Copy this file to .env and customize for your environment

# Adapter addresses for conformance tests
SOURCE_ADAPTER_ADDRESS=localhost:50051
SWITCH_ADAPTER_ADDRESS=localhost:50052
TIMETAGGER_ADAPTER_ADDRESS=localhost:50053

# Optional gRPC `reqType` header metadata. Omit if the adapter does not require it.
# GRPC_HEADER_METADATA_REQTYPE=mock

# Supplies gRPC request bodies for each adapter RPC. Unset uses testdata/<adapter>.json.
# SWITCH_CONFORMANCE_CONFIG=/path/to/your-switch.json
# SOURCE_CONFORMANCE_CONFIG=/path/to/your-source.json
# TIMETAGGER_CONFORMANCE_CONFIG=/path/to/your-timetagger.json
